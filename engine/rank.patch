+)
+
+func TestRankGridJobsOnePerPointWithStableIDs(t *testing.T) {
+	jobs := RankGridJobs("işitme cihazı", "tr", []RankGridPoint{{Lat: 40.991994, Lon: 29.033005}, {Lat: -1.5, Lon: 2.25}}, 15, 1, nil)
+	if len(jobs) != 2 {
+		t.Fatalf("len = %d", len(jobs))
+	}
+
+	for i, want := range []struct{ id, at string }{
+		{"p0", "/@40.9919940,29.0330050,15z"},
+		{"p1", "/@-1.5000000,2.2500000,15z"},
+	} {
+		j := jobs[i].(*GmapJob)
+		if j.ID != want.id || !j.RankOnly || !j.UseInResults() || j.Deduper != nil {
+			t.Errorf("job %d = id %q rankOnly %v dedup %v", i, j.ID, j.RankOnly, j.Deduper)
+		}
+
+		if !strings.Contains(j.URL, want.at) || !strings.Contains(j.URL, "/maps/search/i%C5%9Fitme+cihaz%C4%B1/") {
+			t.Errorf("url %d = %s", i, j.URL)
+		}
+	}
+}
+
+func TestPlaceIDJobsOpenPlacePageDirectly(t *testing.T) {
+	jobs := PlaceIDJobs([]string{"ChIJk9X1Td-5yhQRiqAw0Mp4z3g"}, "tr", true, 40, nil)
+	if len(jobs) != 1 {
+		t.Fatalf("len = %d", len(jobs))
+	}
+
+	j := jobs[0].(*PlaceJob)
+	if j.URL != "https://www.google.com/maps/place/?q=place_id:ChIJk9X1Td-5yhQRiqAw0Mp4z3g" || j.ParentID != "ChIJk9X1Td-5yhQRiqAw0Mp4z3g" || !j.ExtractExtraReviews || !j.UseInResults() || j.MaxReviews != 40 {
+		t.Fatalf("job = %+v", j)
+	}
+}
+
+func TestExtractPlaceIDDoesNotPanic(t *testing.T) {
+	id, err := extractPlaceID("https://www.google.com/maps/place/X/data=!4m7!3m6!1s0x14cab:0x10!8m2")
+	if err != nil || id != "0x14cab:0x10" {
+		t.Fatalf("id = %q err = %v", id, err)
+	}
+}
+
+func TestReviewFetcherStopsAtRequestedCount(t *testing.T) {
+	f := &fetcher{params: fetchReviewsParams{reviewCount: 40}}
+	if f.haveEnough(1) || !f.haveEnough(2) {
+		t.Fatal("40 yorum için 2 sayfa yeterli olmalı")
+	}
+
+	if (&fetcher{}).haveEnough(10) {
+		t.Fatal("sınır yokken sayfalama durmamalı")
+	}
+}
