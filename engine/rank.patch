diff --git a/gmaps/feedrank.go b/gmaps/feedrank.go
new file mode 100644
index 0000000..4d50195
--- /dev/null
+++ b/gmaps/feedrank.go
@@ -0,0 +1,177 @@
+package gmaps
+
+import (
+	"net/url"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/PuerkitoBio/goquery"
+	"golang.org/x/net/html"
+)
+
+// FeedLink, arama sonuç listesindeki bir işletme bağlantısı ve konumudur.
+type FeedLink struct {
+	Href string
+	// Rank: sponsorlu olmayan sonuçlar arasındaki sıra (1'den başlar).
+	// Sponsorlu sonuçta 0'dır.
+	Rank      int
+	Sponsored bool
+}
+
+// Google Haritalar'ın reklam kartlarına koyduğu etiketler. Kart metninde
+// tek başına bir kelime olarak geçtiklerinde kart sponsorlu sayılır.
+var sponsoredLabels = []string{
+	"sponsorlu", "sponsored", "gesponsert", "sponsorisé", "sponsorizzato",
+	"patrocinado", "patrocinada", "gesponsord", "sponsorowane", "реклама",
+	"спонсорство", "إعلان", "ممول", "広告", "광고", "赞助商", "贊助商家",
+}
+
+// FeedLinks, sonuç listesindeki bağlantıları sayfadaki sırayla döndürür.
+// Sıra, işletme sayfaları açılmadan burada sabitlenir.
+func FeedLinks(doc *goquery.Document) []FeedLink {
+	var links []FeedLink
+
+	organic := 0
+
+	doc.Find(`div[role=feed] div[jsaction]>a`).Each(func(_ int, s *goquery.Selection) {
+		href := s.AttrOr("href", "")
+		if href == "" {
+			return
+		}
+
+		link := FeedLink{Href: href, Sponsored: isSponsoredCard(s.Parent())}
+		if !link.Sponsored {
+			organic++
+			link.Rank = organic
+		}
+
+		links = append(links, link)
+	})
+
+	return links
+}
+
+// isSponsoredCard: kartta yalnız etiketten oluşan bir metin parçası varsa
+// reklamdır. Kartın birleşik metnine bakılmaz: öğeler arasında boşluk
+// olmadığı için "ŞubeSponsorlu" gibi birleşir, ve adında "Sponsorlu" geçen
+// bir işletme yanlışlıkla reklam sayılırdı.
+func isSponsoredCard(card *goquery.Selection) bool {
+	found := false
+
+	for _, n := range card.Nodes {
+		walkText(n, func(text string) {
+			t := strings.ToLower(strings.Trim(text, " \t\n ·•()"))
+			for _, label := range sponsoredLabels {
+				if t == label {
+					found = true
+				}
+			}
+		})
+	}
+
+	return found
+}
+
+func walkText(n *html.Node, fn func(string)) {
+	if n.Type == html.TextNode {
+		fn(n.Data)
+	}
+
+	for c := n.FirstChild; c != nil; c = c.NextSibling {
+		walkText(c, fn)
+	}
+}
+
+var (
+	reDataID  = regexp.MustCompile(`!1s(0x[0-9a-fA-F]+:0x[0-9a-fA-F]+)`)
+	reLat     = regexp.MustCompile(`!3d(-?\d+(?:\.\d+)?)`)
+	reLng     = regexp.MustCompile(`!4d(-?\d+(?:\.\d+)?)`)
+	rePlaceID = regexp.MustCompile(`!19s([A-Za-z0-9_-]+)`)
+	reNumbers = regexp.MustCompile(`\d+(?:[.,]\d+)*`)
+)
+
+// FeedEntries, sonuç listesini işletme sayfası açmadan kayıtlara çevirir.
+// Sıra ölçümü için yeterli bilgi kartın kendisinde vardır.
+func FeedEntries(doc *goquery.Document, jobID string) []*Entry {
+	var entries []*Entry
+
+	organic := 0
+
+	doc.Find(`div[role=feed] div[jsaction]>a`).Each(func(_ int, s *goquery.Selection) {
+		href := s.AttrOr("href", "")
+		if href == "" {
+			return
+		}
+
+		card := s.Parent()
+		e := placeURLEntry(href, jobID)
+		e.Position = len(entries) + 1
+		e.Rank = 0
+		e.Sponsored = isSponsoredCard(card)
+
+		if !e.Sponsored {
+			organic++
+			e.Rank = organic
+		}
+
+		if title := strings.TrimSpace(s.AttrOr("aria-label", "")); title != "" {
+			e.Title = title
+		}
+
+		if label, ok := card.Find(`span[role=img][aria-label]`).First().Attr("aria-label"); ok {
+			nums := reNumbers.FindAllString(label, 2)
+			if len(nums) == 2 {
+				e.ReviewRating, _ = strconv.ParseFloat(strings.ReplaceAll(nums[0], ",", "."), 64)
+				e.ReviewCount, _ = strconv.Atoi(strings.NewReplacer(".", "", ",", "").Replace(nums[1]))
+			}
+		}
+
+		e.Category = strings.TrimSpace(card.Find(`.W4Efsd .W4Efsd > span > span`).First().Text())
+
+		entries = append(entries, e)
+	})
+
+	return entries
+}
+
+// placeURLEntry, bir /maps/place/ bağlantısındaki kimlik ve konumu okur.
+// Arama doğrudan tek bir işletmeye gittiğinde de kullanılır (sıra 1).
+func placeURLEntry(u, jobID string) *Entry {
+	e := &Entry{ID: jobID, Link: u, Rank: 1, Position: 1}
+
+	if i := strings.Index(u, "/maps/place/"); i >= 0 {
+		name := u[i+len("/maps/place/"):]
+		if j := strings.IndexAny(name, "/?"); j >= 0 {
+			name = name[:j]
+		}
+
+		if decoded, err := url.QueryUnescape(name); err == nil {
+			e.Title = decoded
+		}
+	}
+
+	if m := reDataID.FindStringSubmatch(u); m != nil {
+		e.DataID = m[1]
+
+		if parts := strings.SplitN(m[1], ":", 2); len(parts) == 2 {
+			if cid, err := strconv.ParseUint(strings.TrimPrefix(parts[1], "0x"), 16, 64); err == nil {
+				e.Cid = strconv.FormatUint(cid, 10)
+			}
+		}
+	}
+
+	if m := reLat.FindStringSubmatch(u); m != nil {
+		e.Latitude, _ = strconv.ParseFloat(m[1], 64)
+	}
+
+	if m := reLng.FindStringSubmatch(u); m != nil {
+		e.Longtitude, _ = strconv.ParseFloat(m[1], 64)
+	}
+
+	if m := rePlaceID.FindStringSubmatch(u); m != nil {
+		e.PlaceID = m[1]
+	}
+
+	return e
+}
diff --git a/gmaps/feedrank_test.go b/gmaps/feedrank_test.go
new file mode 100644
index 0000000..50d9d31
--- /dev/null
+++ b/gmaps/feedrank_test.go
@@ -0,0 +1,155 @@
+package gmaps
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/PuerkitoBio/goquery"
+)
+
+func card(href, text string) string {
+	return `<div jsaction="x"><a href="` + href + `"></a><div>` + text + `</div></div>`
+}
+
+func TestFeedLinksKeepsPageOrderAndSkipsSponsored(t *testing.T) {
+	html := `<div role="feed">` +
+		card("https://maps/place/ad", "<span>Reklamcı Firma</span><span>· Sponsorlu</span>") +
+		card("https://maps/place/a", "Alfa İşitme 4,8") +
+		card("", "bağlantısız kart") +
+		card("https://maps/place/b", "Beta Sponsorluk Merkezi") +
+		card("https://maps/place/c", "<span>Gama</span><span>(Sponsored)</span>") +
+		card("https://maps/place/d", "Delta") +
+		`</div>`
+
+	doc, err := goquery.NewDocumentFromReader(strings.NewReader(html))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	want := []FeedLink{
+		{Href: "https://maps/place/ad", Rank: 0, Sponsored: true},
+		{Href: "https://maps/place/a", Rank: 1},
+		{Href: "https://maps/place/b", Rank: 2},
+		{Href: "https://maps/place/c", Rank: 0, Sponsored: true},
+		{Href: "https://maps/place/d", Rank: 3},
+	}
+
+	assertLinks(t, FeedLinks(doc), want)
+}
+
+// Google'ın gerçek kartında etiket ayrı bir öğededir ve öğeler arasında boşluk
+// yoktur: metin "İdealmed Merkez ŞubeSponsorlu" diye birleşir. Aynı işletme
+// hem reklam hem organik sonuç olarak gelebilir.
+func TestFeedLinksDetectsLabelInOwnElement(t *testing.T) {
+	html := `<div role="feed">` +
+		`<div jsaction="x"><a href="https://maps/place/ideal"></a><div><div>İdealmed Merkez Şube</div><span>Sponsorlu</span></div><div>5,0</div></div>` +
+		`<div jsaction="x"><a href="https://maps/place/idis-ad"></a><div><div>İdis</div><span>Sponsorlu</span></div></div>` +
+		`<div jsaction="x"><a href="https://maps/place/idis"></a><div><div>İdis</div><span>4,9</span></div></div>` +
+		`<div jsaction="x"><a href="https://maps/place/may"></a><div><div>May Sponsorlu Değil</div></div></div>` +
+		`</div>`
+
+	doc, err := goquery.NewDocumentFromReader(strings.NewReader(html))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	assertLinks(t, FeedLinks(doc), []FeedLink{
+		{Href: "https://maps/place/ideal", Sponsored: true},
+		{Href: "https://maps/place/idis-ad", Sponsored: true},
+		{Href: "https://maps/place/idis", Rank: 1},
+		{Href: "https://maps/place/may", Rank: 2},
+	})
+}
+
+func assertLinks(t *testing.T, got, want []FeedLink) {
+	t.Helper()
+
+	if len(got) != len(want) {
+		t.Fatalf("len = %d, want %d: %+v", len(got), len(want), got)
+	}
+
+	for i := range want {
+		if got[i] != want[i] {
+			t.Errorf("link %d = %+v, want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestEntryCsvCarriesRank(t *testing.T) {
+	e := Entry{Rank: 7, Sponsored: false, Position: 9}
+
+	headers, row := e.CsvHeaders(), e.CsvRow()
+	if len(headers) != len(row) {
+		t.Fatalf("headers %d != row %d", len(headers), len(row))
+	}
+
+	n := len(headers)
+	if headers[n-3] != "rank" || row[n-3] != "7" || headers[n-2] != "sponsored" || row[n-2] != "false" || headers[n-1] != "position" || row[n-1] != "9" {
+		t.Fatalf("columns = %v / %v", headers[n-3:], row[n-3:])
+	}
+}
+
+// Gerçek bir Google Haritalar kartından (Kasım 2026) sadeleştirilmiş örnek.
+const realCard = `<div jsaction="x"><a class="hfpxzc" aria-label="İdis İşitme Cihazları - Kadıköy" href="https://www.google.com/maps/place/%C4%B0dis/data=!4m7!3m6!1s0x14cab86f829fc339:0xcab0a54518fd8b7f!8m2!3d40.9895532!4d29.0311416!16s%2Fg%2F1tfn4yq0!19sChIJOcOfgm-4yhQRf4v9GEWlsMo?authuser=0&amp;hl=tr&amp;rclk=1"></a>` +
+	`<div><div class="qBF1Pd">İdis İşitme Cihazları - Kadıköy</div><span role="img" class="ZkP5Je" aria-label="4,9 yıldızlı 562 Yorum"><span>4,9</span><span>(562)</span></span>` +
+	`<div class="W4Efsd"><div class="W4Efsd"><span><span>İşitme Cihazları Satıcısı</span></span><span> · </span><span>Kuşdili Cd. No:14</span></div></div></div></div>`
+
+func TestFeedEntriesBuildRankedEntriesFromCards(t *testing.T) {
+	html := `<div role="feed">` +
+		`<div jsaction="x"><a aria-label="Reklam Yeri" href="https://www.google.com/maps/place/R/data=!4m7!3m6!1s0x1:0x2!8m2!3d41!4d29!19sChIJad"></a><div><span>Sponsorlu</span></div></div>` +
+		realCard +
+		`<div jsaction="x"><a aria-label="Yorumsuz Yer" href="https://www.google.com/maps/place/Y/data=!4m7!3m6!1s0x14cab:0xff!8m2!3d-1.5!4d-2.25"></a><div>Yeni açıldı</div></div>` +
+		`</div>`
+
+	doc, err := goquery.NewDocumentFromReader(strings.NewReader(html))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	got := FeedEntries(doc, "job-1")
+	if len(got) != 3 {
+		t.Fatalf("len = %d", len(got))
+	}
+
+	if got[0].Position != 1 || got[1].Position != 2 || got[2].Position != 3 {
+		t.Errorf("positions = %d %d %d", got[0].Position, got[1].Position, got[2].Position)
+	}
+
+	ad := got[0]
+	if !ad.Sponsored || ad.Rank != 0 || ad.Title != "Reklam Yeri" {
+		t.Errorf("ad = %+v", *ad)
+	}
+
+	e := got[1]
+	if e.ID != "job-1" || e.Rank != 1 || e.Sponsored || e.Title != "İdis İşitme Cihazları - Kadıköy" {
+		t.Errorf("rank/title = %+v", *e)
+	}
+
+	if e.DataID != "0x14cab86f829fc339:0xcab0a54518fd8b7f" || e.Cid != "14605355307753114495" || e.PlaceID != "ChIJOcOfgm-4yhQRf4v9GEWlsMo" {
+		t.Errorf("ids = %q %q %q", e.DataID, e.Cid, e.PlaceID)
+	}
+
+	if e.Latitude != 40.9895532 || e.Longtitude != 29.0311416 {
+		t.Errorf("coords = %v,%v", e.Latitude, e.Longtitude)
+	}
+
+	if e.ReviewRating != 4.9 || e.ReviewCount != 562 || e.Category != "İşitme Cihazları Satıcısı" {
+		t.Errorf("rating/category = %v %v %q", e.ReviewRating, e.ReviewCount, e.Category)
+	}
+
+	if !strings.HasPrefix(e.Link, "https://www.google.com/maps/place/") || strings.Contains(e.Link, "&amp;") {
+		t.Errorf("link = %q", e.Link)
+	}
+
+	plain := got[2]
+	if plain.Rank != 2 || plain.ReviewCount != 0 || plain.PlaceID != "" || plain.Latitude != -1.5 || plain.Longtitude != -2.25 || plain.Cid != "255" {
+		t.Errorf("plain = %+v", *plain)
+	}
+}
+
+func TestPlaceURLEntryForDirectRedirect(t *testing.T) {
+	e := placeURLEntry("https://www.google.com/maps/place/Tek+Yer/data=!4m7!3m6!1s0x14cab:0x10!8m2!3d41.1!4d29.2!19sChIJtek?hl=tr", "job-2")
+	if e == nil || e.Rank != 1 || e.Title != "Tek Yer" || e.Cid != "16" || e.PlaceID != "ChIJtek" || e.ID != "job-2" {
+		t.Fatalf("entry = %+v", e)
+	}
+}
