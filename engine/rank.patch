 	Proxies  []string      `json:"proxies"`
+	// RankOnly: yalnız sonuç listesi okunur (sıra ölçümü için).
+	RankOnly bool `json:"rank_only"`
+	// Points: sıra ızgarası. Her nokta ayrı bir arama olur ve noktalar aynı
+	// iş içinde paralel taranır; sonuç satırının input_id'si "p<sıra>" olur.
+	Points []GeoPoint `json:"points"`
+	// PlaceIDs: arama yapmadan bu işletmelerin sayfaları doğrudan açılır
+	// (tam detay: saat, yorumlar, fotoğraflar, öznitelikler).
+	PlaceIDs []string `json:"place_ids"`
+	// ExtraReviews: işletme sayfasında yorumların tamamı da çekilir (iş bazında).
+	ExtraReviews bool `json:"extra_reviews"`
+	// MaxReviews: işletme sayfasında çekilecek en fazla yorum (0 = sınırsız).
+	MaxReviews int `json:"max_reviews"`
 }
 
+// GeoPoint, ızgaradaki tek bir arama noktasıdır.
+type GeoPoint struct {
