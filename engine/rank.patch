@@ -0,0 +1,54 @@
+package web
+
+import (
+	"testing"
+	"time"
+)
+
+func TestValidateRankGridPoints(t *testing.T) {
+	base := func() JobData {
+		return JobData{Keywords: []string{"a"}, Lang: "tr", Depth: 1, MaxTime: time.Minute, Zoom: 15, RankOnly: true,
+			Points: []GeoPoint{{Lat: 40.9, Lon: 29.0}}}
+	}
+
+	ok := base()
+	if err := ok.Validate(); err != nil {
+		t.Fatalf("valid grid rejected: %v", err)
+	}
+
+	cases := map[string]func(*JobData){
+		"not rank only": func(d *JobData) { d.RankOnly = false },
+		"fast mode":     func(d *JobData) { d.FastMode = true; d.Lat = "1"; d.Lon = "1" },
+		"two keywords":  func(d *JobData) { d.Keywords = []string{"a", "b"} },
+		"no zoom":       func(d *JobData) { d.Zoom = 0 },
+		"bad lat":       func(d *JobData) { d.Points[0].Lat = 91 },
+		"too many": func(d *JobData) {
+			d.Points = make([]GeoPoint, MaxGridPoints+1)
+		},
+	}
+
+	for name, mutate := range cases {
+		d := base()
+		mutate(&d)
+
+		if err := d.Validate(); err == nil {
+			t.Errorf("%s: expected error", name)
+		}
+	}
+}
+
+func TestValidatePlaceIDs(t *testing.T) {
+	ok := JobData{Lang: "tr", Depth: 1, MaxTime: time.Minute, PlaceIDs: []string{"ChIJk9X1Td-5yhQRiqAw0Mp4z3g"}}
+	if err := ok.Validate(); err != nil || len(ok.Keywords) != 1 {
+		t.Fatalf("valid place job rejected: %v %v", err, ok.Keywords)
+	}
+
+	for name, d := range map[string]JobData{
+		"bad id":    {Lang: "tr", Depth: 1, MaxTime: time.Minute, PlaceIDs: []string{"x y"}},
+		"with grid": {Lang: "tr", Depth: 1, MaxTime: time.Minute, Zoom: 15, RankOnly: true, PlaceIDs: []string{"ChIJk9X1Td-5yhQR"}, Points: []GeoPoint{{1, 1}}},
+	} {
+		if err := d.Validate(); err == nil {
+			t.Errorf("%s: expected error", name)
+		}
+	}
+}
