+	Lon float64 `json:"lon"`
+}
+
+// MaxGridPoints, tek işte taranabilecek en fazla nokta (11x11).
+const MaxGridPoints = 121
+
+var gmapsPlaceIDPattern = regexp.MustCompile(`^[A-Za-z0-9_-]{10,256}$`)
+
+// MaxPlaceIDs, tek işte açılabilecek en fazla işletme sayfası.
+const MaxPlaceIDs = 50
+
 func (d *JobData) Validate() error {
+	if len(d.PlaceIDs) > 0 {
+		if len(d.PlaceIDs) > MaxPlaceIDs || len(d.Points) > 0 || d.FastMode || d.RankOnly {
+			return errors.New("place_ids cannot be combined with points, fast_mode or rank_only, max 50")
+		}
+
+		for _, id := range d.PlaceIDs {
+			if !gmapsPlaceIDPattern.MatchString(id) {
+				return errors.New("invalid place id")
+			}
+		}
+
+		if len(d.Keywords) == 0 {
+			d.Keywords = []string{"place"}
+		}
+	}
+
 	if len(d.Keywords) == 0 {
 		return errors.New("missing keywords")
 	}
