+package gmaps
+
+import (
+	"fmt"
+	"net/url"
+	"strconv"
+
+	"github.com/gosom/scrapemate"
+
+	"github.com/gosom/google-maps-scraper/exiter"
+)
+
+// RankGridPoint, sıra ızgarasındaki bir arama noktasıdır.
+type RankGridPoint struct {
+	Lat float64
+	Lon float64
+}
+
+// RankGridJobs, her nokta için sadece-sıra modunda bir arama işi üretir.
+// İş kimliği "p<index>" olur ve sonuç satırlarında input_id olarak döner.
+// Noktalar arasında tekilleştirme yapılmaz: aynı işletme her noktada
+// kendi sırasıyla görünmelidir.
+func RankGridJobs(keyword, langCode string, points []RankGridPoint, zoom, depth int, exitMonitor exiter.Exiter) []scrapemate.IJob {
+	jobs := make([]scrapemate.IJob, 0, len(points))
+
+	for i, p := range points {
+		geo := strconv.FormatFloat(p.Lat, 'f', 7, 64) + "," + strconv.FormatFloat(p.Lon, 'f', 7, 64)
+
+		opts := []GmapJobOptions{}
+		if exitMonitor != nil {
+			opts = append(opts, WithExitMonitor(exitMonitor))
+		}
+
+		job := NewGmapJob(fmt.Sprintf("p%d", i), langCode, keyword, depth, false, geo, zoom, opts...)
+		job.RankOnly = true
+
+		jobs = append(jobs, job)
+	}
+
+	return jobs
+}
+
+// PlaceIDJobs, arama yapmadan işletme sayfalarını place_id ile doğrudan açar.
+func PlaceIDJobs(placeIDs []string, langCode string, extraReviews bool, maxReviews int, exitMonitor exiter.Exiter) []scrapemate.IJob {
+	jobs := make([]scrapemate.IJob, 0, len(placeIDs))
+
+	for _, id := range placeIDs {
+		opts := []PlaceJobOptions{}
+		if exitMonitor != nil {
+			opts = append(opts, WithPlaceJobExitMonitor(exitMonitor))
+		}
+
+		u := "https://www.google.com/maps/place/?q=place_id:" + url.QueryEscape(id)
+		pj := NewPlaceJob(id, langCode, u, false, extraReviews, opts...)
+		pj.MaxReviews = maxReviews
+		jobs = append(jobs, pj)
+	}
+
+	return jobs
+}
