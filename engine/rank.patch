@@ -0,0 +1 @@
+[[["Ci9DQUlRQUNvZENodHljRjlvT2xGMmRraFdhSFowWW0xWVNURTBObEptU3pWWVgxRRAB", ["0x0:0xa73f342ed9222e57", null, 1772186522193853, 1772186522193853, [null, null, ["https://www.google.com/maps/contrib/116111130377271376564/reviews?hl=en"], null, null, ["E. \u00d6.", "https://lh3.googleusercontent.com/a/ACg8ocIiIJCE1nOhvrUjWGAU5TEEFEnwFacfUv-iNG1fEglkcSXazA=s120-c-rp-mo-br100", ["https://www.google.com/maps/contrib/116111130377271376564?hl=en"], "116111130377271376564", null, 2, 0, null, [0, 2, 1], 0, ["2 reviews", null, null, null, null, [null, "0ahUKEwj4wK6t6rmUAxULEWMBHV2BLVoQ7LoGCAkoAA"]]]], null, "2 months ago", null, null, null, null, null, null, ["Google", "https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png", null, null, 5], null, 1, null, 0.9994480013847351], [[1], null, null, null, null, null, null, null, null, null, null, null, null, null, ["de", "en", "German", "English", 1], [["Ich bin sehr entt\u00e4uscht vom Verhalten der Rezeption in dieser Praxis.\nIch hatte seit \u00fcber 10 Tagen anhaltende Blutungen und wollte deshalb dringend \u00e4rztlich abgekl\u00e4rt werden. Telefonisch war die Praxis f\u00fcr mich nicht erreichbar, weshalb ich pers\u00f6nlich vorbeigekommen bin. Dabei habe ich ausdr\u00fccklich betont, dass mir bewusst ist, dass viel los sein kann, und dass ich ohne Vorwurf komme.\n\nLeider wurde ich sehr unfreundlich empfangen. Auf meine Schilderung der anhaltenden Blutungen reagierte die Mitarbeiterin \u00fcberfordert und abweisend. Aussagen wie \u201eIch habe ja nur zwei H\u00e4nde\u201c und \u201eWas suchen Sie hier, Sie m\u00fcssen zum Hausarzt\u201c haben mich in dieser Situation sehr getroffen. Ich habe nochmals ruhig erkl\u00e4rt, dass ich seit \u00fcber 10 Tagen Blutungen habe, bekam jedoch lediglich die Antwort, man k\u00f6nne nichts machen.\n\nGerade bei gesundheitlichen Sorgen erwartet man zumindest ein Mindestma\u00df an Empathie und Unterst\u00fctzung. Ich habe mich nicht ernst genommen und sehr allein gelassen gef\u00fchlt.", null, [0, 228]], ["I am very disappointed with the reception staff at this practice.\n\nI had been experiencing continuous bleeding for over 10 days and urgently needed to see a doctor. I couldn't reach the practice by phone, so I went in person. I explicitly stated that I understood they might be busy and that I was there without any resentment.\n\nUnfortunately, I was greeted very rudely. The staff member reacted to my description of the ongoing bleeding in an overwhelmed and dismissive manner. Statements like \"I only have two hands\" and \"What are you doing here? You need to see your family doctor\" deeply offended me in this situation. I calmly explained again that I had been bleeding for over 10 days, but was simply told that nothing could be done.\n\nEspecially when you have health concerns, you expect at least a minimum of empathy and support. I felt disregarded and very alone.", null, [0, 147]]]], [null, 1772266947000000, 1772266947000000, "2 months ago", null, "https://business.google.com/local/business/4798856530163220559/customers/reviews/reply?p=CkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHTW1ScmFGZGhTRm93V1cweFdWTlVSVEJPYkVwdFUzcFdXVmd4UlJBQhAA", [null, null, null, "/local/business/4798856530163220559/customers/reviews/reply?p=CkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHTW1ScmFGZGhTRm93V1cweFdWTlVSVEJPYkVwdFUzcFdXVmd4UlJBQhAA"], "https://business.google.com/local/business/4798856530163220559/customers/reviews/deletereply?p=CkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHTW1ScmFGZGhTRm93V1cweFdWTlVSVEJPYkVwdFUzcFdXVmd4UlJBQhAA", [null, null, null, "/local/business/4798856530163220559/customers/reviews/deletereply?p=CkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHTW1ScmFGZGhTRm93V1cweFdWTlVSVEJPYkVwdFUzcFdXVmd4UlJBQhAA"], null, "https://business.google.com/local/business/4798856530163220559/customers/reviews/reply?p=CkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHTW1ScmFGZGhTRm93V1cweFdWTlVSVEJPYkVwdFUzcFdXVmd4UlJBQhAA", [null, null, null, "/local/business/4798856530163220559/customers/reviews/reply?p=CkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHTW1ScmFGZGhTRm93V1cweFdWTlVSVEJPYkVwdFUzcFdXVmd4UlJBQhAA"], null, ["de", "en", "German", "English", 1], [["Es tut uns sehr leid, dass Sie sich in einer ohnehin belastenden gesundheitlichen Situation nicht gut aufgehoben gef\u00fchlt haben. \n\nUm solche Situationen zu vermeiden, haben wir feste Telefonsprechzeiten eingerichtet, zu denen wir pers\u00f6nlich erreichbar sind. Diese sind auf unserer Website ver\u00f6ffentlicht. Au\u00dferhalb dieser Zeiten f\u00fchrt unser Telefonmen\u00fc Schritt f\u00fcr Schritt durch die Optionen. Bei akuten Beschwerden besteht w\u00e4hrend unserer \u00d6ffnungszeiten jederzeit die M\u00f6glichkeit, eine Nachricht zu hinterlassen \u2013 auf diese R\u00fcckrufbitten reagieren wir in der Regel innerhalb einer Stunde. So k\u00f6nnen wir dringende F\u00e4lle kurzfristig und gezielt in den Praxisablauf integrieren.\n\nUnser Team arbeitet t\u00e4glich daran, einen reibungslosen Ablauf sicherzustellen \u2013 auch in Wochen wie dieser, in denen krankheitsbedingte Ausf\u00e4lle im Team die Belastung zus\u00e4tzlich erh\u00f6hen. Umso bedauerlicher ist es, dass Sie dies als unfreundlich empfunden haben. Wie wir in Zukunft mit solchen Situationen besser umgehen k\u00f6nnen, werden wir intern besprechen.\n\nSollten Sie weiterhin Beschwerden haben, melden Sie sich bitte am Montag Vormittag, wie oben beschrieben.  \n\nIhr Praxisteam", null, [0, 127]], ["We are very sorry that you did not feel well cared for during an already stressful health situation.\n\nTo avoid such situations, we have established fixed telephone consultation hours during which we are personally available. These are published on our website. Outside of these hours, our telephone menu guides you step-by-step through the options. In case of acute symptoms, you can leave a message at any time during our opening hours \u2013 we usually respond to these callback requests within one hour. This allows us to integrate urgent cases into the practice's workflow quickly and efficiently.\n\nOur team works daily to ensure a smooth process \u2013 even in weeks like this one, when staff absences due to illness further increase the workload. It is all the more regrettable that you perceived this as unfriendly. We will discuss internally how we can better handle such situations in the future.\n\nShould you continue to experience symptoms, please contact us on Monday morning as described above.\n\nYour Practice Team", null, [0, 100]]]], [null, null, 3333, ["https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xGMmRraFdhSFowWW0xWVNURTBObEptU3pWWVgxRRAB!2m1!1s0x0:0xa73f342ed9222e57!3m1!1s2@1:CAIQACodChtycF9oOlF2dkhWaHZ0Ym1YSTE0NlJmSzVYX1E%7C%7C?hl=en"], ["https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2xGMmRraFdhSFowWW0xWVNURTBObEptU3pWWVgxRRAB&t=1&entityid=Ci9DQUlRQUNvZENodHljRjlvT2xGMmRraFdhSFowWW0xWVNURTBObEptU3pWWVgxRRI-Ci9DQUlRQUNvZENodHljRjlvT2xGMmRraFdhSFowWW0xWVNURTBObEptU3pWWVgxRRILMGRjTGlQQVlVVGYaPgovQ0FJUUFDb2RDaHR5Y0Y5b09sRjJka2hXYUhaMFltMVlTVEUwTmxKbVN6VllYMUUSCzBkY0xpUEFZVVRmIhIJAAAAAAAAAAARVy4i2S40P6cqCzBkY0xpUEFZVVRm&wv=1&d=286732320", null, null, "0ahUKEwj4wK6t6rmUAxULEWMBHV2BLVoQoykICigB"], null, [null, [[1, 0]]]], "0ahUKEwj4wK6t6rmUAxULEWMBHV2BLVoQ0pMFCAgoAg"], null, "CAQSRENqRUlBUklwQ2dvQVA3X2FBSi05X19fX0VoQlN4elhmQTZobkhfOWY1M0lBQUFBQUdnbjkyUHNDWTJGenJhNFlBQ0lB:3"]]
