+}
+
+func TestExtractPlaceIDDoesNotPanic(t *testing.T) {
+	id, err := extractPlaceID("https://www.google.com/maps/place/X/data=!4m7!3m6!1s0x14cab:0x10!8m2")
+	if err != nil || id != "0x14cab:0x10" {
+		t.Fatalf("id = %q err = %v", id, err)
+	}
+}
+
+func TestReviewFetcherStopsAtRequestedCount(t *testing.T) {
+	f := &fetcher{params: fetchReviewsParams{reviewCount: 40}}
+	if f.haveEnough(1) || !f.haveEnough(2) {
