 		return errors.New("missing geo coordinates")
 	}
 
+	if len(d.Points) > 0 {
+		if !d.RankOnly || d.FastMode {
+			return errors.New("points require rank_only and no fast_mode")
+		}
+
+		if len(d.Keywords) != 1 {
+			return errors.New("points require exactly one keyword")
+		}
+
+		if len(d.Points) > MaxGridPoints {
+			return errors.New("too many points")
+		}
+
+		if d.Zoom < 1 || d.Zoom > 21 {
+			return errors.New("points require zoom between 1 and 21")
+		}
+
+		for _, p := range d.Points {
+			if p.Lat < -90 || p.Lat > 90 || p.Lon < -180 || p.Lon > 180 {
+				return errors.New("invalid point coordinates")
+			}
+		}
+	}
+
 	return nil
 }
